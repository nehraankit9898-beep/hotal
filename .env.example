# StayLoop environment template — copy to .env and fill in.
# NEVER commit real secrets. Generate secrets with: openssl rand -hex 32
# See docs/ENVIRONMENT.md for the full reference.

# ---------- Required (production) ----------
# Session-token signing key (>= 32 chars; required in production, fail-closed).
# DEV: leave empty — a dev secret auto-generates on first boot (.auth-secret.dev).
AUTH_SECRET=
# DEV (SQLite): create + seed the local demo database once with:
#   bun run dev:setup          (db push + demo seed data)
# The release zip ships NO demo database — never restore one from an archive.
DATABASE_URL="file:../db/custom.db"
# PRODUCTION: replace with PostgreSQL, e.g.
# DATABASE_URL="postgresql://user:pass@host:5432/stayloop?connection_limit=20"

# AES-256-GCM key for integration credentials at rest — 64 hex chars (32 bytes).
# Required in production; fail-closed.
INTEGRATION_ENCRYPTION_KEY=

# ---------- Webhooks ----------
# HMAC key for engagement-tracking webhooks (>= 32 chars).
# Webhooks return 503 when unset in production.
TRACKING_WEBHOOK_SECRET=

# ---------- Cron / automation ----------
# HMAC key for follow-up engine cron invocations (optional; must be strong when set)
FOLLOWUP_ENGINE_SECRET=

# ---------- One-time Super Admin bootstrap (Phase 2) ----------
# Required to create the FIRST super admin via scripts/bootstrap-admin.ts or
# POST /api/super-admin/bootstrap. Leave unset to disable bootstrap entirely.
ADMIN_BOOTSTRAP_SECRET=

# ---------- Phase 7: distributed rate limiting ----------
# Optional. When set, the rate limiter uses Redis across all instances
# (atomic fixed-window counters). Without it, an in-process fallback is used
# per instance (documented limitation for multi-instance deployments).
# REDIS_URL=redis://localhost:6379

# ---------- Phase 7: email transport (EmailService) ----------
# Provider selection: auto (default) | smtp | resend | sendgrid | mock
EMAIL_PROVIDER=auto
# SMTP endpoint (smtp://user:pass@host:port or smtps://…). AWS SES is
# supported via its SMTP interface (email-smtp.<region>.amazonaws.com).
SMTP_URL=
# Resend HTTPS transport
RESEND_API_KEY=
# SendGrid HTTPS transport
SENDGRID_API_KEY=
# From header, e.g. "StayLoop <no-reply@yourdomain.com>" (required in
# production when a provider is configured).
EMAIL_FROM=
# Public https origin used to build verification / reset links
# (required in production when REQUIRE_EMAIL_VERIFICATION=true).
APP_ORIGIN=
# Block sign-in until the address is verified (true|false; default false).
REQUIRE_EMAIL_VERIFICATION=false

# ---------- Messaging providers (optional — Simulation mode without them) ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------- Phase 7: queue thresholds ----------
# Campaign audiences above this size are sent via the background worker
# (HTTP 202) instead of inline in the request.
INLINE_SEND_THRESHOLD=25
# CSV exports above this row count are queued for the worker.
EXPORT_INLINE_MAX_ROWS=5000

# ---------- Misc ----------
BOOKING_LINK=
# Optional — estimated cost per message for campaign ROI (default 0.5 = ₹0.50).
# Phase 10: all SaaS knobs (plans, pricing, trial duration, limits, flags,
# maintenance mode) are DATABASE-driven and managed from the Super Admin UI —
# no env vars needed for them.
COST_PER_MESSAGE=
# Extra origins (comma/space separated) allowed for CORS on /api/* —
# same-origin by default; never a wildcard for credentialed APIs.
TRUSTED_ORIGINS=
# Space-separated origins allowed to embed the app in an iframe (CSP
# frame-ancestors). PRODUCTION DEFAULT: 'self'. Never use "*" blindly.
EMBED_FRAME_ANCESTORS=
# Structured log level: debug | info | warn | error (default info in production)
LOG_LEVEL=info
# Debug: set to 1 to log all Prisma queries (never enable in production).
LOG_PRISMA_QUERIES=
