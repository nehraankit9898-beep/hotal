// StayLoop — Hotel Customer Retention SaaS
// Multi-tenant schema covering Phase 1 - Phase 6
// Designed to be PostgreSQL-compatible (switch datasource provider for production)

// NOTE (bug-report item 9): both generators share ONE output path —
// generating this client OVERWRITES the other client ("last generate wins").
// After generating the PostgreSQL client, always re-run
//   bunx prisma generate --schema prisma/schema.prisma
// before running the dev/test harness (it expects the SQLite client).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =====================
// RBAC — Phase 6 expanded roles
// =====================
enum UserRole {
  SUPER_ADMIN // platform-wide administrator (Phase 6)
  HOTEL_OWNER // full access to own hotel (Phase 6)
  HOTEL_ADMIN // hotel admin (Phase 1+2)
  HOTEL_MANAGER // operational + marketing access (Phase 6)
  MARKETING_MANAGER
  RESTAURANT_MANAGER
  FRONT_DESK
  HOTEL_STAFF
  // Phase 13 — restaurant staff roles (appended: PostgreSQL enum values
  // must be added at the END for existing installations to migrate safely).
  CASHIER // POS billing view, order payment context
  KITCHEN_STAFF // KDS queue + item availability only
  WAITER // floor/table overview, order taking, serve
}

// Phase 3 — one-time owner invitation / activation tokens (only the HASH is stored)
model ActivationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  purpose   String    @default("OWNER_INVITATION") // OWNER_INVITATION | PASSWORD_RESET
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum HotelStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

model Hotel {
  id        String      @id @default(uuid())
  name      String
  location  String?
  phone     String?
  email     String?
  status    HotelStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Phase 6 — tenant extensions
  tenantId         String? // super-admin tenant grouping (one tenant per hotel for MVP)
  address          String?
  city             String?
  state            String?
  country          String?
  website          String?
  gstin            String?
  timezone         String?   @default("Asia/Kolkata")
  currency         String?   @default("INR")
  planId           String?
  plan             Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  suspendedAt      DateTime?
  suspensionReason String?

  users                   User[]
  customers               Customer[]
  visits                  Visit[]
  auditLogs               AuditLog[]
  // Phase 2
  segments                Segment[]
  campaigns               Campaign[]
  campaignMessages        CampaignMessage[]
  followUpSteps           FollowUpStep[]
  // Phase 3
  coupons                 Coupon[]
  journeys                Journey[]
  // Phase 4
  automationRules         AutomationRule[]
  leadEvents              LeadEvent[]
  // Phase 5
  restaurantVisits        RestaurantVisit[]
  restaurantOrders        RestaurantOrder[]
  // Phase 6
  tenantFeatures          TenantFeature[]
  usageRecords            UsageRecord[]
  subscriptions           Subscription[]
  supportSessions         SupportSession[]
  integrations            Integration[]
  notifications           Notification[]
  // Phase 6.3 — restaurant growth
  loyaltySettings         LoyaltySettings?
  loyaltyAccounts         LoyaltyAccount[]
  loyaltyTransactions     LoyaltyTransaction[]
  qrCodes                 QRCode[]
  feedbacks               Feedback[]
  messageTemplates        MessageTemplate[]
  hotelSettings           HotelSettings?
  // Phase 7 — background jobs (campaign sends, exports)
  backgroundJobs          BackgroundJob[]
  // Phase 11 — developer API keys
  apiKeys                 ApiKey[]
  // Phase 10 — SaaS billing
  payments                Payment[]
  // Phase 12 — restaurant menu & tables
  menuCategories          MenuCategory[]
  menuItems               MenuItem[]
  menuOptionGroups        MenuOptionGroup[]
  menuOptions             MenuOption[]
  diningTables            DiningTable[]
  // Phase 13 — ordering, sessions, staff
  tableSessions           TableSession[]
  diningOrders            DiningOrder[]
  orderEvents             OrderEvent[]
  // Phase 11 — journey execution
  journeyEnrollments      JourneyEnrollment[]
  journeyStepDeliveries   JourneyStepDelivery[]
  // Phase 14 — POS, GST billing & restaurant payments
  taxRules                TaxRule[]
  invoiceSequences        InvoiceSequence[]
  bills                   Bill[]
  billPayments            BillPayment[]
  billRefunds             BillRefund[]
  cashSessions            CashSession[]
  // Phase 15 — retention & marketing
  referralProgram         ReferralProgram?
  referralCodes           ReferralCode[]
  referrals               Referral[]
  promotions              Promotion[]
  paymentLinks            PaymentLink[]
  reportSchedule          ReportSchedule?
  restaurantWebhookEvents RestaurantWebhookEvent[]
  // Phase 16 — operations
  reservations            Reservation[]
  ingredients             Ingredient[]
  stockLedger             StockLedger[]
  recipeLines             RecipeLine[]
  suppliers               Supplier[]
  purchaseOrders          PurchaseOrder[]
  stockCounts             StockCount[]
  attendanceRecords       AttendanceRecord[]
  shiftAssignments        ShiftAssignment[]
  branchMembership        BranchMembership?

  // Phase 17 — enterprise & platform completion
  branchMenuOverrides  BranchMenuOverride[]
  whiteLabelConfig     WhiteLabelConfig?
  customRoles          CustomRole[]
  webhookEndpoints     WebhookEndpoint[]
  privacyRequests      PrivacyRequest[]
  subscriptionMandates SubscriptionMandate[]
  subscriptionRefunds  SubscriptionRefund[]
  competitorBenchmarks CompetitorBenchmark[]

  // Phase 18 — advanced AI & innovation
  aiSettings           AISettings?
  aiConversations      AIConversation[]
  aiInteractionLogs    AIInteractionLog[]
  demandForecasts      DemandForecast[]
  aiRecommendations    AIRecommendation[]
  walletPasses         WalletPass[]
  sustainabilityBadges SustainabilityBadge[]

  @@index([status])
  @@index([planId])
}

model User {
  id                  String     @id @default(uuid())
  hotelId             String?
  hotel               Hotel?     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name                String
  email               String     @unique
  passwordHash        String
  role                UserRole   @default(HOTEL_STAFF)
  status              UserStatus @default(ACTIVE)
  // Phase 6 — security extensions
  mfaEnabled          Boolean    @default(false)
  mfaSecret           String?
  // Phase 10 — TOTP MFA (RFC 6238) + single-use hashed backup codes
  mfaBackupCodes      String? // JSON array of sha256-hashed backup codes
  mfaEnforcedAt       DateTime? // when MFA policy began applying to this user
  // SECURITY FIX (TOTP replay): last accepted TOTP time-step; a code whose step
  // is <= this value is rejected, so one code can only be used once.
  mfaLastUsedStep     Int?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  // Phase 2 hardening — secure bootstrap/invitation
  mustChangePassword  Boolean    @default(false)
  // Phase 9 — session revocation: bump to invalidate all issued tokens
  tokenVersion        Int        @default(0)
  // Phase 7 — email verification (null = not yet verified)
  emailVerified       DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // Phase 16 — staff operations
  attendanceRecords AttendanceRecord[]
  shiftAssignments  ShiftAssignment[]
  auditLogs         AuditLog[]
  supportSessions   SupportSession[]
  leadEvents        LeadEvent[]
  activationTokens  ActivationToken[]

  // Phase 17 — enterprise & platform completion
  customRoleAssignments CustomRoleAssignment[]
  abAssignments         ABAssignment[]
  franchiseOrgAdmins    FranchiseOrganizationAdmin[]

  @@index([hotelId])
  @@index([role])
}

model Customer {
  id                    String         @id @default(uuid())
  hotelId               String
  hotel                 Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name                  String
  phone                 String
  email                 String?
  marketingConsent      Boolean        @default(false)
  consentTimestamp      DateTime?
  consentSource         String?
  optOut                Boolean        @default(false)
  status                CustomerStatus @default(ACTIVE)
  // ---- Phase 2: customer intelligence fields ----
  roomPreference        String?
  foodPreference        String?
  location              String?
  birthday              DateTime?
  anniversary           DateTime?
  source                String?
  notes                 String?
  vip                   Boolean        @default(false)
  // ---- Phase 3: extended CRM fields ----
  whatsappOptIn         Boolean        @default(false)
  smsOptIn              Boolean        @default(false)
  emailOptIn            Boolean        @default(false)
  preferredRoom         String?
  preferredService      String?
  loyaltyPoints         Int            @default(0)
  recencyScore          Int            @default(0)
  frequencyScore        Int            @default(0)
  monetaryScore         Int            @default(0)
  customerValueScore    Int            @default(0)
  leadScore             Int            @default(0) // Phase 4
  leadTier              String? // COLD | WARM | HOT | VERY_HOT (Phase 4)
  // ---- Phase 5: restaurant intelligence ----
  favouriteItems        String? // JSON array of items
  favouriteCategory     String?
  diningFrequency       Int            @default(0)
  lastRestaurantVisit   DateTime?
  totalRestaurantVisits Int            @default(0)
  totalRestaurantSpend  Float          @default(0)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  visits               Visit[]
  segments             SegmentMember[]
  messages             CampaignMessage[]
  // Phase 3
  couponRedemptions    CouponRedemption[]
  timelineEvents       TimelineEvent[]
  // Phase 4
  leadEvents           LeadEvent[]
  // Phase 5
  restaurantVisits     RestaurantVisit[]
  restaurantOrders     RestaurantOrder[]
  // Phase 4 (automation executions)
  automationExecutions AutomationExecution[]
  // Phase 11 — journey enrollments
  journeyEnrollments   JourneyEnrollment[]
  // Phase 6.3 — restaurant growth
  loyaltyAccounts      LoyaltyAccount[]
  loyaltyTransactions  LoyaltyTransaction[]
  feedbacks            Feedback[]
  // Phase 14/15 — POS bills & referral program
  bills                Bill[]
  referralCodes        ReferralCode[]        @relation("ReferralCodeOwner")
  referralsMade        Referral[]            @relation("ReferralsMade")
  referralsReceived    Referral[]            @relation("ReferralsReceived")
  // Phase 18 — advanced AI & innovation
  aiConversations      AIConversation[]
  aiRecommendations    AIRecommendation[]
  walletPasses         WalletPass[]

  @@unique([hotelId, phone])
  @@index([hotelId])
  @@index([email])
  @@index([marketingConsent])
  @@index([status])
  @@index([vip])
  @@index([leadTier])
  @@index([birthday])
}

model Visit {
  id         String    @id @default(uuid())
  hotelId    String
  hotel      Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  checkin    DateTime
  checkout   DateTime?
  source     String    @default("MANUAL")
  notes      String?
  amount     Float?
  roomType   String? // Phase 3 — preferred room tracking
  guests     Int       @default(1)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([hotelId])
  @@index([customerId])
  @@index([checkin])
  @@index([checkout])
}

model AuditLog {
  id         String   @id @default(uuid())
  hotelId    String?
  hotel      Hotel?   @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  metadata   String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([hotelId])
  @@index([action])
  @@index([createdAt])
  @@index([userId])
}

model AuthAttempt {
  id        String   @id @default(uuid())
  email     String
  success   Boolean
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

// =====================
// Phase 2: Customer Intelligence & Segmentation Engine
// =====================

enum SegmentType {
  AUTO
  MANUAL
}

enum SegmentMemberSource {
  AUTO
  MANUAL
}

model Segment {
  id             String      @id @default(uuid())
  hotelId        String
  hotel          Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  type           SegmentType @default(MANUAL)
  rule           String?
  isSystem       Boolean     @default(false)
  color          String?
  // Phase 3 — configurable thresholds
  visitThreshold Int?
  spendThreshold Float?
  inactiveDays   Int?
  lostDays       Int?
  // Phase 5 — restaurant segments flag
  domain         String? // HOTEL | RESTAURANT
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  members   SegmentMember[]
  campaigns Campaign[]

  @@unique([hotelId, name])
  @@index([hotelId])
  @@index([type])
  @@index([domain])
}

model SegmentMember {
  id         String              @id @default(uuid())
  segmentId  String
  segment    Segment             @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  source     SegmentMemberSource @default(MANUAL)
  createdAt  DateTime            @default(now())

  @@unique([segmentId, customerId])
  @@index([customerId])
  @@index([segmentId])
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  COMPLETED
  PAUSED // Phase 3
  FAILED
  ARCHIVED
}

enum CampaignScheduleType {
  NOW
  SCHEDULED
  AUTOMATED
}

model Campaign {
  id                      String               @id @default(uuid())
  hotelId                 String
  hotel                   Hotel                @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name                    String
  description             String?
  status                  CampaignStatus       @default(DRAFT)
  scheduleType            CampaignScheduleType @default(NOW)
  scheduledAt             DateTime?
  segmentId               String?
  segment                 Segment?             @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  channels                String
  offer                   String?
  couponId                String? // Phase 3 — link to coupon
  coupon                  Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  messageTemplate         String
  // Recheck fix (D — WhatsApp template wiring): optional link to an APPROVED
  // WhatsApp MessageTemplate. When set (and the template is provider-approved
  // for WHATSAPP), the send pipeline transmits a provider TEMPLATE payload
  // (providerTemplateId + language + positional variables) instead of
  // free-form text — required for delivery outside WhatsApp's 24-hour
  // customer-service window. SMS/EMAIL keep the free-form body.
  messageTemplateId       String?
  messageTemplateRef      MessageTemplate?     @relation(fields: [messageTemplateId], references: [id], onDelete: SetNull)
  followUpStepId          String?
  followUpStep            FollowUpStep?        @relation(fields: [followUpStepId], references: [id], onDelete: SetNull)
  createdById             String?
  lastSentAt              DateTime?
  // Phase 4 — campaign attribution
  campaignType            String? // THANK_YOU | REVIEW | BIRTHDAY | ANNIVERSARY | REPEAT_BOOKING | SPECIAL_OFFER | FESTIVAL | WEEKEND | REACTIVATION | VIP | WIN_BACK
  startDate               DateTime?
  endDate                 DateTime?
  // Phase 4 — frequency caps
  frequencyCapPerCustomer Int                  @default(1)
  frequencyWindowDays     Int                  @default(30)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  messages CampaignMessage[]

  @@unique([followUpStepId])
  @@index([hotelId])
  @@index([status])
  @@index([campaignType])
}

enum MessageChannel {
  WHATSAPP
  SMS
  EMAIL
}

enum MessageStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
  // Phase 6.4 — simulation mode is recorded as its own status so a simulated
  // delivery is NEVER mistaken for a real provider delivery.
  SIMULATED
  // Audit fix F07 — delivery-state honesty + concurrency safety:
  //   UNKNOWN   — the provider call may or may not have completed (crash window).
  //               UNKNOWN rows are NEVER auto-retried; they need explicit
  //               provider reconciliation before any resend.
  //   RETRYING  — an atomic per-message claim held by exactly one retry runner.
  //               Only the runner that wins the FAILED → RETRYING transition
  //               may call the provider (prevents concurrent duplicate sends).
  UNKNOWN
  RETRYING
}

model CampaignMessage {
  id                  String         @id @default(uuid())
  hotelId             String
  hotel               Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  campaignId          String
  campaign            Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId          String
  customer            Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel             MessageChannel
  recipient           String
  personalizedMessage String
  status              MessageStatus  @default(PENDING)
  skipReason          String?
  provider            String?
  providerMessageId   String?
  failureReason       String?
  sentAt              DateTime?
  deliveredAt         DateTime?
  openedAt            DateTime?
  clickedAt           DateTime?
  repliedAt           DateTime? // Phase 4 — reply tracking
  // ---- revenue attribution ----
  bookingLinked       Boolean        @default(false)
  bookingAmount       Float?
  bookingAt           DateTime?
  // Phase 4 — lead scoring
  attributedRevenue   Float?         @default(0)
  // Phase 6 — idempotency key
  idempotencyKey      String?        @unique
  // Phase 6.4 — safe retry support (exponential backoff, max attempts)
  retryCount          Int            @default(0)
  lastTriedAt         DateTime?
  createdAt           DateTime       @default(now())

  @@unique([campaignId, customerId, channel])
  @@index([hotelId])
  @@index([campaignId])
  @@index([customerId])
  @@index([status])
  @@index([sentAt])
}

model FollowUpStep {
  id              String   @id @default(uuid())
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  offsetDays      Int
  label           String
  messageTemplate String
  channels        String
  enabled         Boolean  @default(true)
  sortOrder       Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  campaign Campaign?

  @@unique([hotelId, offsetDays])
  @@index([hotelId])
}

// =====================
// Phase 3: Coupons, Loyalty, Customer Timeline, Journeys
// =====================

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  CUSTOMER_SPECIFIC
  ONE_TIME
}

model Coupon {
  id               String             @id @default(uuid())
  hotelId          String
  hotel            Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  code             String // uppercase coupon code
  description      String?
  discountType     CouponDiscountType @default(PERCENTAGE)
  discountValue    Float              @default(0) // percentage or amount
  minimumOrder     Float?
  maximumDiscount  Float?
  validFrom        DateTime?
  validUntil       DateTime?
  usageLimit       Int                @default(0) // 0 = unlimited
  customerLimit    Int                @default(1)
  active           Boolean            @default(true)
  // Phase 6 — attribution
  totalRedemptions Int                @default(0)
  totalDiscount    Float              @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  redemptions CouponRedemption[]
  campaigns   Campaign[]
  // Phase 18 — AI recommendations referencing this coupon
  aiRecommendations AIRecommendation[]

  @@unique([hotelId, code])
  @@index([hotelId])
  @@index([code])
}

model CouponRedemption {
  id             String   @id @default(uuid())
  couponId       String
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  hotelId        String
  orderId        String?
  orderAmount    Float?
  discountAmount Float
  // Phase 13 — concurrency: per-customer slot reservation (DB-arbitrated)
  redemptionSlot Int      @default(0)
  redeemedAt     DateTime @default(now())

  @@unique([couponId, customerId, orderId])
  @@unique([couponId, customerId, redemptionSlot])
  @@index([couponId])
  @@index([customerId])
}

enum TimelineEventType {
  CUSTOMER_CREATED
  BOOKING
  CHECKOUT
  PAYMENT
  FEEDBACK
  CAMPAIGN_SENT
  CAMPAIGN_OPENED
  CAMPAIGN_CLICKED
  CAMPAIGN_REPLIED
  COUPON_ISSUED
  COUPON_REDEEMED
  ADMIN_NOTE
  SEGMENT_ADDED
  CONSENT_GRANTED
  CONSENT_REVOKED
  BIRTHDAY
  ANNIVERSARY
  RESTAURANT_VISIT
}

model TimelineEvent {
  id         String            @id @default(uuid())
  hotelId    String
  customerId String
  customer   Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       TimelineEventType
  label      String
  detail     String?
  amount     Float?
  userId     String?
  createdAt  DateTime          @default(now())

  @@index([customerId])
  @@index([hotelId])
  @@index([type])
  @@index([createdAt])
}

model Journey {
  id          String   @id @default(uuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name        String
  description String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps       JourneyStep[]
  enrollments JourneyEnrollment[]

  @@index([hotelId])
}

model JourneyStep {
  id              String  @id @default(uuid())
  journeyId       String
  journey         Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  offsetDays      Int
  label           String
  messageTemplate String
  channels        String
  offer           String?
  couponId        String?
  sortOrder       Int
  enabled         Boolean @default(true)

  deliveries JourneyStepDelivery[]

  @@index([journeyId])
}

// ---------- Phase 11 — durable journey execution ----------

enum JourneyEnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum JourneyDeliveryStatus {
  PENDING
  SENDING
  SENT
  SKIPPED
  FAILED
}

model JourneyEnrollment {
  id            String                  @id @default(uuid())
  hotelId       String
  hotel         Hotel                   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  journeyId     String
  journey       Journey                 @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status        JourneyEnrollmentStatus @default(ACTIVE)
  enrolledAt    DateTime                @default(now())
  // Cursor semantics: index of the next step to schedule/deliver. Progress is
  // persisted PER CUSTOMER here; per-step delivery evidence lives in
  // JourneyStepDelivery (one row per step/customer/occurrence).
  nextStepIndex Int                     @default(0)
  nextStepAt    DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  deliveries JourneyStepDelivery[]

  @@unique([journeyId, customerId]) // one enrollment per customer per journey
  @@index([hotelId])
  @@index([status, nextStepAt])
}

model JourneyStepDelivery {
  id            String                @id @default(uuid())
  enrollmentId  String
  enrollment    JourneyEnrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  journeyStepId String
  journeyStep   JourneyStep           @relation(fields: [journeyStepId], references: [id], onDelete: Cascade)
  hotelId       String
  hotel         Hotel                 @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  customerId    String
  // One delivery reservation per step/customer/occurrence: the calendar date
  // (UTC day) this occurrence is due — repeated steps (birthdays) get a new
  // key next year, so the unique constraint enforces exactly-once per run.
  occurrenceKey String
  status        JourneyDeliveryStatus @default(PENDING)
  // BUG-5/D12: durable retry budget — a delivery is retried by the sweep
  // until this hits the cap, instead of being silently dropped after the
  // first transient failure.
  retryCount    Int                   @default(0)
  scheduledFor  DateTime
  messageId     String? // CampaignMessage once sent
  sentAt        DateTime?
  error         String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([enrollmentId, journeyStepId, occurrenceKey])
  @@index([status, scheduledFor])
  @@index([hotelId])
}

// =====================
// Phase 4: Automation Rules & Lead Scoring
// =====================

enum AutomationTrigger {
  HOTEL_CHECKOUT
  RESTAURANT_VISIT
  INACTIVE_7
  INACTIVE_15
  INACTIVE_30
  BIRTHDAY
  ANNIVERSARY
  VIP_THRESHOLD
  OFFER_UNUSED
  REPEAT_VISIT
  SPECIAL_EVENT
  CAMPAIGN_OPENED
  CAMPAIGN_CLICKED
  CAMPAIGN_REPLIED
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
  FAILED
}

model AutomationRule {
  id              String            @id @default(uuid())
  hotelId         String
  hotel           Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  trigger         AutomationTrigger
  waitDays        Int               @default(0)
  conditions      String? // JSON: list of conditions
  actions         String // JSON: list of actions
  channels        String // JSON: list of channels
  messageTemplate String?
  offer           String?
  couponId        String?
  status          AutomationStatus  @default(DRAFT)
  runsCount       Int               @default(0)
  lastRunAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  executions AutomationExecution[]

  @@index([hotelId])
  @@index([trigger])
  @@index([status])
}

enum AutomationExecutionStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}

model AutomationExecution {
  id            String                    @id @default(uuid())
  automationId  String
  automation    AutomationRule            @relation(fields: [automationId], references: [id], onDelete: Cascade)
  hotelId       String
  customerId    String
  customer      Customer                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  trigger       String
  status        AutomationExecutionStatus @default(PENDING)
  scheduledAt   DateTime
  executedAt    DateTime?
  retryCount    Int                       @default(0)
  failureReason String?
  result        String? // JSON summary
  createdAt     DateTime                  @default(now())

  @@index([automationId])
  @@index([hotelId])
  @@index([customerId])
  @@index([status])
  @@index([scheduledAt])
}

enum LeadEventType {
  MESSAGE_OPENED
  LINK_CLICKED
  REPLIED
  OFFER_VIEWED
  BOOKING_PAGE_VISITED
  BOOKING_COMPLETED
  COUPON_REDEEMED
}

model LeadEvent {
  id         String        @id @default(uuid())
  hotelId    String
  hotel      Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  campaignId String?
  messageId  String?
  userId     String?
  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  type       LeadEventType
  points     Int           @default(0)
  metadata   String?
  createdAt  DateTime      @default(now())

  // Phase 14 — idempotency: the same engagement event can never be recorded twice
  @@unique([customerId, type, messageId])
  @@index([customerId])
  @@index([hotelId])
  @@index([type])
}

// =====================
// Phase 5: Restaurant Customer Growth Engine
// =====================

enum RestaurantVisitSource {
  WALK_IN
  RESERVATION
  ROOM_GUEST
  EVENT
  ONLINE_ORDER
  QR_MENU
  WIFI_LOGIN
  FEEDBACK
  LOYALTY
}

model RestaurantVisit {
