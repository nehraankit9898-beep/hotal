// LEGACY NOTE (Phase 13): RestaurantOrder above is the Phase 5 analytics-only
// record (imported/aggregated order history). Live restaurant ordering uses
// DiningOrder below. Do NOT reinterpret existing rows — the backfill story is
// documented in PHASE_13_HANDOFF.md.

// =====================
// Phase 12 — Digital menu & table management
// =====================

model MenuCategory {
